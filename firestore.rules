rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Work Orders Collection
    // Each work order document must have a 'userId' field matching the creator's UID.
    match /workOrders/{workOrderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    // Allow users to list ONLY their own work orders.
    // This rule relies on the client-side query containing: where('userId', '==', request.auth.uid)
    match /workOrders/{document=**} {
       allow list: if request.auth != null && request.query.resource.data.userId == request.auth.uid;
       // A more robust list rule might inspect request.query.filters directly,
       // but this often gets complex. Relying on client queries with proper indexing and
       // server-side validation (if any sensitive fields were involved beyond userId) is common.
       // For now, we assume client makes the correct "where userId == uid" query.
       // If the client tries to list all without this where clause, it might be denied if no broader read rule exists.
       // Let's refine the list rule to be more explicit about the query:
       // allow list: if request.auth != null &&
       //                request.query.filters.find(f => f[0].fieldPath == "userId" && f[1] == "==" && f[2] == request.auth.uid) != null;
       // This is still complex. A simpler approach for now is to ensure the client does its job.
       // The current rule for `list` means that if a query is made on `workOrders` collection,
       // it will be allowed if the query somehow ensures that the resulting documents would have matched `resource.data.userId == request.auth.uid`.
       // This is usually achieved by client-side `where("userId", "==", request.auth.uid)`.
    }


    // Shared Data Collections (publicly readable, admin-only write - admin role not implemented yet)
    // So effectively read-only for general users for now.
    match /stoneTypes/{stoneTypeId} {
      allow read: if true;
      allow write: if false; // Future: if request.auth.token.admin == true;
    }
    match /stoneTypes/{document=**} { // For listing all stone types
        allow list: if true;
    }

    match /edgeDefinitions/{edgeDefId} {
      allow read: if true;
      allow write: if false;
    }
     match /edgeDefinitions/{document=**} {
        allow list: if true;
    }

    match /faceDefinitions/{faceDefId} {
      allow read: if true;
      allow write: if false;
    }
    match /faceDefinitions/{document=**} {
        allow list: if true;
    }

    match /palletTypes/{palletTypeId} {
      allow read: if true;
      allow write: if false;
    }
    match /palletTypes/{document=**} {
        allow list: if true;
    }

    // Default deny all other paths / collections unless explicitly allowed.
    // This is implicit if no other rules match.
  }
}
