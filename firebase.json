{
  "hosting": {
    "public": "public", // Serves files from the public directory
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        // If you were using Next.js with SSR and Firebase Functions:
        // "source": "**",
        // "function": "nextServer" // Assuming a Firebase Function named nextServer
        // For a basic SPA-like behavior or if only static parts are hosted:
        "source": "**",
        "destination": "/index.html" // Or your main entry point if it were a pure SPA
                                    // For Next.js, this needs to be more sophisticated.
                                    // Often, for full Next.js features, you'd use a framework-aware deployment.
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**", // Cache static assets generated by Next.js
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/static/**", // Cache files in your /public/static folder (if any)
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
  // "functions": { // Example if using Firebase Functions for Next.js server
  //   "source": ".", // Or your functions directory
  //   "runtime": "nodejs18" // Or your preferred runtime
  // }
}
